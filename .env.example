# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://freshfinish-cs.co.uk

# Quote form — destination inbox for enquiries
QUOTE_FORM_TO_EMAIL=info@freshfinish-cs.co.uk

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Optional: custom "from" address once your domain is verified on Resend.
# Leave unset to use Resend's default sender (onboarding@resend.dev).
# QUOTE_FORM_FROM_EMAIL=Fresh Finish <noreply@freshfinish-cs.co.uk>
